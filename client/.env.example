# ─── Client Environment Variables ────────────────────────────────────────────
#
# VITE_API_URL — Backend API base URL (must include /api suffix)
#
# Development:
#   Leave this unset (or set to /api) — Vite proxy handles /api and /uploads.
#   VITE_API_URL=/api
#
# Production:
#   Set to your deployed backend's full URL including the /api path segment.
#   The app automatically strips /api to derive the backend origin for
#   serving uploaded media files (profile image, resume, project images).
#   VITE_API_URL=https://your-backend.example.com/api
#
VITE_API_URL=http://localhost:5000/api
